msgstr ""
"Nem sikerült beolvasni a HOOKS tömböt az /etc/mkinitcpio.conf fájlból."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 721
#: usr/share/biglinux/grub-restore/backend/system_interface.py:794
msgid ""
"The initramfs configuration is missing hooks required to find and mount the "
"root filesystem."
msgstr ""
"Az initramfs-konfigurációból hiányoznak a gyökér-fájlrendszer megtalálásához"
" és csatolásához szükséges hookok."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 747
#: usr/share/biglinux/grub-restore/backend/system_interface.py:820
msgid "The current GRUB configuration references a different root UUID."
msgstr "A jelenlegi GRUB-konfiguráció más gyökér-UUID-re hivatkozik."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 753
#: usr/share/biglinux/grub-restore/backend/system_interface.py:826
msgid "The current GRUB configuration references a different Btrfs subvolume."
msgstr "A jelenlegi GRUB-konfiguráció más Btrfs-alkötetre hivatkozik."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 759
#: usr/share/biglinux/grub-restore/backend/system_interface.py:832
