# restore/backend/system_interface.py, line: 43
#: usr/share/biglinux/grub-restore/backend/system_interface.py:416
#, python-format
msgid "System detection failed: %s"
msgstr "Falha na detecção do sistema: %s"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:439
msgid "Configured as /boot/efi in the selected system"
msgstr "Configurada como /boot/efi no sistema selecionado"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:442
msgid "Same physical disk as the selected system"
msgstr "Mesmo disco físico do sistema selecionado"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:445
msgid "Contains an existing EFI boot directory"
msgstr "Contém um diretório de inicialização EFI existente"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:447
msgid "Valid EFI System Partition"
msgstr "Partição do Sistema EFI válida"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:462
#: usr/share/biglinux/grub-restore/backend/system_interface.py:468
msgid "Unknown size"
msgstr "Tamanho desconhecido"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:523
#: usr/share/biglinux/grub-restore/backend/system_interface.py:774
msgid "No system was selected."
msgstr "Nenhum sistema foi selecionado."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:547
#: usr/share/biglinux/grub-restore/gui/window.py:1110
msgid "The selected root does not contain a recognizable Linux installation."
msgstr "A raiz selecionada não contém uma instalação Linux reconhecível."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:553
#: usr/share/biglinux/grub-restore/gui/window.py:1113
msgid "The selected root filesystem has no UUID."
msgstr "O sistema de arquivos raiz selecionado não tem UUID."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:561
msgid "No root filesystem entry was found in /etc/fstab."
msgstr ""
"Nenhuma entrada para o sistema de arquivos raiz foi encontrada em "
"/etc/fstab."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:569
msgid "The root entry in /etc/fstab points to a different or missing device."
msgstr ""
"A entrada da raiz em /etc/fstab aponta para um dispositivo diferente ou "
"ausente."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:577
msgid ""
"The root filesystem type in /etc/fstab does not match the detected system."
msgstr ""
"O tipo do sistema de arquivos raiz em /etc/fstab não corresponde ao sistema "
"detectado."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:589
msgid "The root subvolume in /etc/fstab does not match the detected system."
msgstr "O subvolume raiz em /etc/fstab não corresponde ao sistema detectado."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:613
msgid "No bootable kernel image was found in /boot."
msgstr "Nenhuma imagem de kernel inicializável foi encontrada em /boot."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:619
msgid "No initramfs image was found; the repair must regenerate it."
msgstr ""
"Nenhuma imagem initramfs foi encontrada; o reparo precisa regenerá-la."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:631
#: usr/share/biglinux/grub-restore/gui/window.py:1119
msgid "No supported initramfs generator was found in the installed system."
msgstr ""
"Nenhum gerador de initramfs compatível foi encontrado no sistema instalado."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:646
#: usr/share/biglinux/grub-restore/gui/window.py:1122
msgid ""
"No mkinitcpio preset was found; no initramfs can be regenerated safely."
msgstr ""
"Nenhum preset do mkinitcpio foi encontrado; não é possível regenerar o "
"initramfs com segurança."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:652
msgid "The HOOKS array in /etc/mkinitcpio.conf could not be read."
msgstr "Não foi possível ler o array HOOKS em /etc/mkinitcpio.conf."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:663
msgid ""
"The initramfs configuration is missing hooks required to find and mount the "
"root filesystem."
msgstr ""
"A configuração do initramfs não contém os hooks necessários para localizar e"
" montar o sistema de arquivos raiz."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:689
msgid "The current GRUB configuration references a different root UUID."
msgstr "A configuração atual do GRUB referencia um UUID de raiz diferente."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:695
msgid "The current GRUB configuration references a different Btrfs subvolume."
msgstr "A configuração atual do GRUB referencia um subvolume Btrfs diferente."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:701
msgid "No GRUB configuration file was found; the repair must create it."
msgstr ""
"Nenhum arquivo de configuração do GRUB foi encontrado; o reparo precisa "
"criá-lo."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:715
msgid "Btrfs reports device errors. Back up important data before writing."
msgstr ""
"O Btrfs relata erros de dispositivo. Faça backup dos dados importantes antes"
" de realizar qualquer gravação."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:755
#, python-format
msgid "Invalid block device selected: %s"
msgstr "Dispositivo de bloco inválido selecionado: %s"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:757
#, python-format
msgid "Selected block device no longer exists: %s"
msgstr "O dispositivo de bloco selecionado não existe mais: %s"
#: usr/share/biglinux/grub-restore/backend/system_interface.py:803
msgid "The selected partition is not a validated EFI System Partition."
msgstr "A partição selecionada não é uma Partição do Sistema EFI validada."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:810
msgid "The selected GPT disk has no BIOS boot partition."
msgstr ""
"O disco GPT selecionado não possui uma partição de inicialização BIOS."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:816
#: usr/share/biglinux/grub-restore/gui/window.py:1183
msgid "Invalid restore mode."
msgstr "Modo de restauração inválido."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:818
msgid "This GRUB restore backend currently supports x86-64 only."
msgstr ""
"Este backend de restauração do GRUB oferece suporte apenas a x86-64 no "
"momento."
#: usr/share/biglinux/grub-restore/backend/system_interface.py:821
msgid ""
"Package repair is supported only for BigLinux, Arch Linux, and Manjaro "
"systems."
msgstr ""
"O reparo de pacotes é compatível apenas com sistemas BigLinux, Arch Linux e "
"Manjaro."
