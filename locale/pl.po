#: usr/share/biglinux/grub-restore/backend/system_interface.py:777
#: usr/share/biglinux/grub-restore/gui/window.py:1246
msgid ""
"No mkinitcpio preset was found; no initramfs can be regenerated safely."
msgstr ""
"Nie znaleziono presetu mkinitcpio; nie można bezpiecznie wygenerować "
"ponownie initramfs."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 710
#: usr/share/biglinux/grub-restore/backend/system_interface.py:783
