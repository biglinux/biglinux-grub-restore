#: usr/share/biglinux/grub-restore/backend/system_interface.py:684
#: usr/share/biglinux/grub-restore/gui/window.py:1237
msgid "The selected root filesystem has no UUID."
msgstr "Wybrany główny system plików nie ma identyfikatora UUID."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 619
#: usr/share/biglinux/grub-restore/backend/system_interface.py:692
msgid "No root filesystem entry was found in /etc/fstab."
msgstr "W /etc/fstab nie znaleziono wpisu głównego systemu plików."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 627
#: usr/share/biglinux/grub-restore/backend/system_interface.py:700
msgid "The root entry in /etc/fstab points to a different or missing device."
msgstr ""
"Wpis głównego systemu plików w /etc/fstab wskazuje na inne lub nieistniejące"
" urządzenie."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 635
#: usr/share/biglinux/grub-restore/backend/system_interface.py:708
msgid ""
"The root filesystem type in /etc/fstab does not match the detected system."
msgstr ""
"Typ głównego systemu plików w /etc/fstab nie jest zgodny z wykrytym "
"systemem."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 647
#: usr/share/biglinux/grub-restore/backend/system_interface.py:720
msgid "The root subvolume in /etc/fstab does not match the detected system."
msgstr "Podwolumin główny w /etc/fstab nie jest zgodny z wykrytym systemem."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 671
#: usr/share/biglinux/grub-restore/backend/system_interface.py:744
msgid "No bootable kernel image was found in /boot."
msgstr "W /boot nie znaleziono rozruchowego obrazu jądra."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 677
#: usr/share/biglinux/grub-restore/backend/system_interface.py:750
msgid "No initramfs image was found; the repair must regenerate it."
msgstr ""
"Nie znaleziono obrazu initramfs; naprawa musi go wygenerować ponownie."

# #-#-#-#-#  biglinux-grub-restore.pot (biglinux-grub-restore)  #-#-#-#-#
# 
