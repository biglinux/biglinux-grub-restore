msgstr "Der blev ikke fundet nogen post for rodfilsystemet i /etc/fstab."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 627
#: usr/share/biglinux/grub-restore/backend/system_interface.py:700
msgid "The root entry in /etc/fstab points to a different or missing device."
msgstr ""
"Rodposten i /etc/fstab peger på en anden enhed eller på en enhed, der ikke "
"findes."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 635
#: usr/share/biglinux/grub-restore/backend/system_interface.py:708
msgid ""
"The root filesystem type in /etc/fstab does not match the detected system."
msgstr "Rodfilsystemets type i /etc/fstab svarer ikke til det fundne system."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 647
#: usr/share/biglinux/grub-restore/backend/system_interface.py:720
msgid "The root subvolume in /etc/fstab does not match the detected system."
msgstr "Rod-undervolumenet i /etc/fstab svarer ikke til det fundne system."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 671
#: usr/share/biglinux/grub-restore/backend/system_interface.py:744
