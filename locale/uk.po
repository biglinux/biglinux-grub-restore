msgstr "Вибраний блоковий пристрій більше не існує: %s"

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 861
#: usr/share/biglinux/grub-restore/backend/system_interface.py:955
