msgstr ""
"Вибраний кореневий розділ не містить розпізнаваної встановленої системи "
"Linux."

# #-#-#-#-#  biglinux-grub-restore.pot (biglinux-grub-restore)  #-#-#-#-#
# 
# File: biglinux-grub-restore/usr/share/biglinux/grub-restore/gui/window.py,
# line: 1113
# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 611
#: usr/share/biglinux/grub-restore/backend/system_interface.py:684
#: usr/share/biglinux/grub-restore/gui/window.py:1237
msgid "The selected root filesystem has no UUID."
msgstr "Вибрана коренева файлова система не має UUID."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 619
#: usr/share/biglinux/grub-restore/backend/system_interface.py:692
msgid "No root filesystem entry was found in /etc/fstab."
msgstr "У /etc/fstab не знайдено запису кореневої файлової системи."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 627
#: usr/share/biglinux/grub-restore/backend/system_interface.py:700
msgid "The root entry in /etc/fstab points to a different or missing device."
msgstr ""
"Запис кореневого розділу в /etc/fstab вказує на інший або відсутній "
"пристрій."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 635
#: usr/share/biglinux/grub-restore/backend/system_interface.py:708
msgid ""
"The root filesystem type in /etc/fstab does not match the detected system."
msgstr ""
"Тип кореневої файлової системи в /etc/fstab не відповідає виявленій системі."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 647
#: usr/share/biglinux/grub-restore/backend/system_interface.py:720
msgid "The root subvolume in /etc/fstab does not match the detected system."
msgstr "Кореневий підтом у /etc/fstab не відповідає виявленій системі."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 671
#: usr/share/biglinux/grub-restore/backend/system_interface.py:744
msgid "No bootable kernel image was found in /boot."
msgstr "У /boot не знайдено завантажувального образу ядра."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 677
#: usr/share/biglinux/grub-restore/backend/system_interface.py:750
msgid "No initramfs image was found; the repair must regenerate it."
msgstr ""
"Образ initramfs не знайдено; під час виправлення його потрібно створити "
"заново."

# #-#-#-#-#  biglinux-grub-restore.pot (biglinux-grub-restore)  #-#-#-#-#
# 
# File: biglinux-grub-restore/usr/share/biglinux/grub-restore/gui/window.py,
# line: 1119
# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 689
#: usr/share/biglinux/grub-restore/backend/system_interface.py:762
#: usr/share/biglinux/grub-restore/gui/window.py:1243
msgid "No supported initramfs generator was found in the installed system."
msgstr ""
"У встановленій системі не знайдено підтримуваного генератора initramfs."

# #-#-#-#-#  biglinux-grub-restore.pot (biglinux-grub-restore)  #-#-#-#-#
# 
# File: biglinux-grub-restore/usr/share/biglinux/grub-restore/gui/window.py,
# line: 1122
# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 704
#: usr/share/biglinux/grub-restore/backend/system_interface.py:777
#: usr/share/biglinux/grub-restore/gui/window.py:1246
msgid ""
"No mkinitcpio preset was found; no initramfs can be regenerated safely."
msgstr ""
"Не знайдено пресету mkinitcpio; initramfs неможливо безпечно створити "
"заново."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 710
#: usr/share/biglinux/grub-restore/backend/system_interface.py:783
msgid "The HOOKS array in /etc/mkinitcpio.conf could not be read."
msgstr "Не вдалося прочитати масив HOOKS у /etc/mkinitcpio.conf."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 721
#: usr/share/biglinux/grub-restore/backend/system_interface.py:794
msgid ""
"The initramfs configuration is missing hooks required to find and mount the "
"root filesystem."
msgstr ""
"У конфігурації initramfs бракує хуків, потрібних для пошуку та монтування "
"кореневої файлової системи."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 747
#: usr/share/biglinux/grub-restore/backend/system_interface.py:820
msgid "The current GRUB configuration references a different root UUID."
msgstr ""
"Поточна конфігурація GRUB посилається на інший UUID кореневого розділу."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 753
#: usr/share/biglinux/grub-restore/backend/system_interface.py:826
msgid "The current GRUB configuration references a different Btrfs subvolume."
msgstr "Поточна конфігурація GRUB посилається на інший підтом Btrfs."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 759
#: usr/share/biglinux/grub-restore/backend/system_interface.py:832
msgid "No GRUB configuration file was found; the repair must create it."
msgstr ""
"Файл конфігурації GRUB не знайдено; під час виправлення його потрібно "
"створити."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 773
#: usr/share/biglinux/grub-restore/backend/system_interface.py:846
msgid "Btrfs reports device errors. Back up important data before writing."
msgstr ""
"Btrfs повідомляє про помилки пристрою. Перед записом створіть резервну копію"
" важливих даних."

#: usr/share/biglinux/grub-restore/backend/system_interface.py:864
#, python-format
msgid ""
"GRUB is also installed on %s. The computer starts from only one disk: if it "
"still stops at \"grub rescue\" after this repair, repeat the repair choosing"
" that disk."
msgstr ""
"GRUB також встановлено на %s. Комп'ютер завантажується лише з одного диска: "
"якщо після цього виправлення він і далі зупиняється на «grub rescue», "
"повторіть виправлення, вибравши той диск."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 813
#: usr/share/biglinux/grub-restore/backend/system_interface.py:907
#, python-format
