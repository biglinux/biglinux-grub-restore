msgid "The selected root filesystem has no UUID."
msgstr "У выбранной корневой файловой системы нет UUID."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 619
#: usr/share/biglinux/grub-restore/backend/system_interface.py:692
msgid "No root filesystem entry was found in /etc/fstab."
msgstr "В /etc/fstab не найдена запись корневой файловой системы."

# File: biglinux-grub-restore/usr/share/biglinux/grub-
# restore/backend/system_interface.py, line: 627
#: usr/share/biglinux/grub-restore/backend/system_interface.py:700
